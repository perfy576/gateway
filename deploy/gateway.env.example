# Copy to /etc/gateway.env, fill in deployment values, and restrict permissions to 0600.
DB_HOST=mysql.example.com
DB_PORT=3306
DB_NAME=gateway
DB_USER=gateway
DB_PASSWORD=replace-with-a-database-password
DB_TLS_REQUIRED=true
# DB_TLS_CA=/path/to/mysql-ca.pem

GATEWAY_HOST=gateway.example.com
GATEWAY_PORT=19090
GATEWAY_WEB_ROOT=/opt/gateway/web
GATEWAY_STATE_DIR=/var/lib/gateway
# Optional. The persistent RSA private key is created with mode 0600 if missing.
# GATEWAY_PASSWORD_KEY_FILE=/var/lib/gateway/password-private.pem
GATEWAY_SESSION_SECONDS=43200
# Comma-separated domains that must not be managed by this gateway.
GATEWAY_RESERVED_HOSTS=
